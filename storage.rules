rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function sizeUnder(maxMB) {
      return request.resource.size < maxMB * 1024 * 1024;
    }

    // ── GALERÍA: galeria/{uid}/{archivo} ──
    match /galeria/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && isImage()
                   && sizeUnder(8);
    }

    // ── LOGOS (subidos desde onboarding) ──
    match /logos/{fileName} {
      allow read: if true;
      allow create: if isImage() && sizeUnder(5);
      allow update, delete: if false;
    }

    // Bloqueo por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
